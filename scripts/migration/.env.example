# Supabase Configuration
# Required: The base URL of your Supabase project (e.g. https://onsvnudakxkrqazrufar.supabase.co)
SUPABASE_URL=https://onsvnudakxkrqazrufar.supabase.co

# Required for ETL bypass of RLS: Service Role Key (from Supabase Dashboard -> Project Settings -> API -> service_role secret)
# Note: You can also use SUPABASE_ANON_KEY if RLS policies allow public insert or if authenticated
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Firebase Source Configuration (Option 1: Live Firestore Extraction)
# Path to your Firebase service account JSON key file
FIREBASE_SERVICE_ACCOUNT_KEY=./serviceAccountKey.json

# Storage Buckets (Pre-configured to match Supabase schema)
SUPABASE_COVERS_BUCKET=covers
SUPABASE_AUDIO_BUCKET=audio
SUPABASE_AVATARS_BUCKET=avatars

# Migration Settings
BATCH_SIZE=50
MEDIA_CONCURRENCY=5
